# ==============================================================================
# ANX-CLUB — MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# In production, configure these variables in your deployment environment (e.g. Vercel).
#
# SECURITY RULES:
# 1. Never commit .env.local or raw credentials to source control.
# 2. In production (NODE_ENV=production), TURSO_DATABASE_URL, TURSO_AUTH_TOKEN, 
#    and TOKEN_ENCRYPTION_KEY are strictly mandatory.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & BASE URL
# ------------------------------------------------------------------------------
# Scope: Server & Client
NODE_ENV=development
# Base application URL (http://localhost:3000 in dev, https://your-domain.com in prod)
NEXT_PUBLIC_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. TURSO / LIBSQL EDGE DATABASE (AUTHORITATIVE APPLICATION DATABASE)
# ------------------------------------------------------------------------------
# Purpose: Authoritative database for users, roles, memberships, mentors, sessions, and payments.
# Where to obtain: https://turso.tech/ > Create Database > View Database Details
# Scope: Server-side only
# In development: defaults to 'file:anx_local.db' if omitted.
# In production: TURSO_DATABASE_URL and TURSO_AUTH_TOKEN are strictly required.
TURSO_DATABASE_URL=file:anx_local.db
TURSO_AUTH_TOKEN=your-turso-auth-token-for-production

# ------------------------------------------------------------------------------
# 3. TOKEN ENCRYPTION KEY (AES-256-GCM)
# ------------------------------------------------------------------------------
# Purpose: Encrypts Google OAuth access and refresh tokens stored in mentors table.
# Where to obtain: Generate locally using OpenSSL:
#   Command: openssl rand -hex 32
# Scope: Server-side only
# Requirement: Mandatory 64-character hexadecimal string (32 bytes).
TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 4. FIREBASE ADMIN SDK (SERVER-SIDE IDENTITY VERIFICATION)
# ------------------------------------------------------------------------------
# Purpose: Cryptographically verifies Firebase ID tokens and establishes WHO the user is.
# Where to obtain: Firebase Console > Project Settings > Service accounts > "Generate new private key"
# Scope: Server-side only
# Requirement: Mandatory
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Note: In .env.local, wrap the multiline PEM in quotes and preserve literal \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...YOUR_KEY...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 5. FIREBASE CLIENT SDK (FRONTEND AUTHENTICATION)
# ------------------------------------------------------------------------------
# Purpose: Client-side login, signup, Google popup, and token generation.
# Where to obtain: Firebase Console > Project Settings > General > Your Apps > Web App Config
# Scope: Frontend (Exposed to browser via NEXT_PUBLIC_)
# Requirement: Mandatory
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA...your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------------
# 6. GOOGLE CALENDAR & GOOGLE MEET OAUTH2
# ------------------------------------------------------------------------------
# Purpose: Mentors connect their Google Calendar to generate authentic Google Meet links.
# Where to obtain: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Scope: Server-side only
# Authorized Redirect URI required in Google Console:
#   Development: http://localhost:3000/api/auth/google/callback
#   Production:  https://your-domain.com/api/auth/google/callback
# Minimum scope requested: https://www.googleapis.com/auth/calendar.events
# Requirement: Mandatory for calendar integration
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# (Backward compatibility aliases for legacy utilities)
GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ------------------------------------------------------------------------------
# 7. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Purpose: Membership subscriptions (₹149/mo, ₹999/yr) and paid mentoring sessions.
# Where to obtain: Razorpay Dashboard > Settings > API Keys
# Scope: Key ID is Frontend; Key Secret and Webhook Secret are Server-side only.
# Requirement: Mandatory for checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 8. CLOUDFLARE WORKER & FCM PUSH NOTIFICATIONS
# ------------------------------------------------------------------------------
# Purpose: Edge-dispatched, HMAC-signed push notifications for mentoring events.
# Where to obtain: Cloudflare Dashboard > Workers & Pages
# Scope:
#   - CF_WORKER_URL / CF_WEBHOOK_SECRET: Next.js server configuration
#   - FCM_SERVICE_ACCOUNT: Cloudflare Worker environment secret (JSON string)
CF_WORKER_URL=https://anx-fcm-worker.your-account.workers.dev/api/push
CF_WEBHOOK_SECRET=your-32-byte-hmac-secret-for-worker-communication
# Alias:
WEBHOOK_HMAC_SECRET=your-32-byte-hmac-secret-for-worker-communication

# ------------------------------------------------------------------------------
# 9. CRON SECRET (CRON JOB AUTHORIZATION)
# ------------------------------------------------------------------------------
# Purpose: Secures /api/cron/* endpoints against unauthorized execution with constant-time check.
# Where to obtain: Generate any random secure string (e.g. openssl rand -hex 16)
# Scope: Server-side only
# Caller sends header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-secure-cron-job-authorization-secret

# ------------------------------------------------------------------------------
# 10. OPTIONAL EXTERNAL INTEGRATIONS
# ------------------------------------------------------------------------------
# FAST2SMS (Phone OTP delivery): https://www.fast2sms.com
FAST2SMS_API_KEY=your_fast2sms_api_key

# RESEND (Transactional confirmation emails): https://resend.com
RESEND_API_KEY=re_your_resend_api_key

# GOOGLE GEMINI (AI roadmap recommendations): https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key

# WATI.IO (WhatsApp notifications): https://www.wati.io
WATI_API_ENDPOINT=https://live-server-XXXXX.wati.io
WATI_API_TOKEN=your-wati-api-token
